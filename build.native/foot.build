#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup --prefix=/usr -Dtests=false --wipe
ninja
meson install --destdir=/tmp/stage
mkdir -p /tmp/stage/etc/installer/foot
find /tmp/stage -name '*.so*' -exec strip --strip-all {} \;
echo 'foot ??? tllist libwayland fontconfig fcft tllist' > /tmp/stage/etc/installer/foot/pkinfo
cd $wd
./flashpack /tmp/stage
mv /tmp/stage/*.tar .
