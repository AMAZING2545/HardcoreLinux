#!/bin/sh
set -eu

: "${dir:?set dir to the extracted iwd source tree}"
: "${YSPM_BIN:=yspm}"

VERSION="${VERSION:-git}"
ARCH="${ARCH:-x86_64}"
ABI="${YSPM_ABI:-yspm-abi-1}"
OUT="${OUTPUT:-iwd-${VERSION}-${ARCH}.yspkg}"
STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT

cd "$dir"
if [ -x ./autogen.sh ] && [ ! -f ./configure ]; then
    ./autogen.sh
fi
./configure --prefix=/usr --sysconfdir=/etc --disable-manual
make -j$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)
make DESTDIR="$STAGE" install

"$YSPM_BIN" build \
  --root "$STAGE" \
  --output "$OUT" \
  --name iwd \
  --version "$VERSION" \
  --description "Minimal wireless daemon" \
  --abi "$ABI" \
  --arch "$ARCH" \
  --license GPL-2.0
echo "$OUT"
