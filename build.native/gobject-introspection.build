#!/bin/sh
set -eu

: "${dir:?set dir to the extracted gobject-introspection source tree}"
: "${YSPM_BIN:=yspm}"
REPO_ROOT="${REPO_ROOT:-.}"
OUT="${OUTPUT:-gobject-introspection-1.82.0-${ARCH:-x86_64}.yspkg}"
sh "$REPO_ROOT/tools/build-native-meson" "$dir" "$OUT" "gobject-introspection" "1.82.0" "GObject introspection runtime and tools"
