

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup .. --prefix=/usr --reconfigure -Dtests=disabled
ninja
meson install --destdir=/tmp/stage
mkdir -p /tmp/stage/etc/installer/harfbuzz
find /tmp/stage -name *.so -exec strip --strip-all {} \;
echo 'harfbuzz 14.3.0 musl glib libcairo_png' > /tmp/stage/etc/installer/harfbuzz/pkinfo
rm -rf /tmp/stage/usr/share/man
rm -rf /tmp/stage/usr/share/info
rm -rf /tmp/stage/usr/share/doc
cd $wd
./flashpack /tmp/stage
mv /tmp/stage/*.tar .
