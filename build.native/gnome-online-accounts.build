#!/bin/sh
set -eu

: "${dir:?set dir to the extracted gnome-online-accounts source tree}"
: "${YSPM_BIN:=yspm}"
REPO_ROOT="${REPO_ROOT:-.}"
OUT="${OUTPUT:-gnome-online-accounts-3.54.1-${ARCH:-x86_64}.yspkg}"
sh "$REPO_ROOT/tools/build-native-meson" "$dir" "$OUT" "gnome-online-accounts" "3.54.1" "Online account integration for GNOME"
