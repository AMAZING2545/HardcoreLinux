

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup .. --reconfigure -Dprefix=/usr
ninja
meson install --destdir=/tmp/stage
mkdir -p /tmp/stage/etc/installer/libdrm
find /tmp/stage -name *.so -exec strip --strip-all {} \;
echo 'libdrm 2.134.0 musl zlib libpciaccess' > /tmp/stage/etc/installer/libdrm/pkinfo
cd $wd
./flashpack /tmp/stage
mv /tmp/stage/*.tar .
