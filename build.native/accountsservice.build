#!/bin/sh
set -eu

: "${dir:?set dir to the extracted accountsservice source tree}"
: "${YSPM_BIN:=yspm}"

REPO_ROOT="${REPO_ROOT:-.}"
OUT="${OUTPUT:-accountsservice-23.13.9-${ARCH:-x86_64}.yspkg}"
sh "$REPO_ROOT/tools/build-native-meson"  "$dir" "$OUT" "accountsservice" "23.13.9" "System account information service"
