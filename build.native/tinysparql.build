#!/bin/sh
set -eu

: "${dir:?set dir to the extracted tinysparql source tree}"
: "${YSPM_BIN:=yspm}"
REPO_ROOT="${REPO_ROOT:-.}"
OUT="${OUTPUT:-tinysparql-3.10.0-${ARCH:-x86_64}.yspkg}"
sh "$REPO_ROOT/tools/build-native-meson" "$dir" "$OUT" "tinysparql" "3.10.0" "GNOME local metadata and SPARQL service"
