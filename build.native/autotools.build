#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
./configure --prefix=/usr
make -j$(nproc)
make DESTDIR=/tmp/stage install
rm -r /tmp/stage/usr/share/info
rm -r /tmp/stage/usr/share/man
mkdir -p /tmp/stage/etc/installer/autotools
echo 'autotools 2.73 musl m4' > /tmp/stage/etc/installer/autotools/pkinfo
cd $wd
./flashpack /tmp/stage
cp /tmp/stage/*.tar .
