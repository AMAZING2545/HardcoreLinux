#!/bin/sh
set -eu

: "${dir:?set dir to the extracted gnome-initial-setup source tree}"
: "${YSPM_BIN:=yspm}"

REPO_ROOT="${REPO_ROOT:-.}"
OUT="${OUTPUT:-gnome-initial-setup-51.0-${ARCH:-x86_64}.yspkg}"

sh "$REPO_ROOT/tools/build-native-meson" "$dir" "$OUT" "gnome-initial-setup" "51.0" "GNOME first-run setup"
