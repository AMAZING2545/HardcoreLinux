#!/bin/sh
set -eu

: "${dir:?set dir to the extracted iio-sensor-proxy source tree}"
: "${YSPM_BIN:=yspm}"
REPO_ROOT="${REPO_ROOT:-.}"
OUT="${OUTPUT:-iio-sensor-proxy-3.7-${ARCH:-x86_64}.yspkg}"
sh "$REPO_ROOT/tools/build-native-meson" "$dir" "$OUT" "iio-sensor-proxy" "3.7" "Sensor proxy for laptop orientation and ambient sensors"
