

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup .. --prefix=/usr -Dopenmp=disabled -Dloongson-mmi=disabled --reconfigure
ninja
meson install --destdir=/tmp/stage
mkdir -p /tmp/stage/etc/installer/pixman
find /tmp/stage -name *.so -exec strip --strip-all {} \;
echo 'pixman 0.46.4 musl' > /tmp/stage/etc/installer/pixman/pkinfo
cd $wd
./flashpack /tmp/stage
mv /tmp/stage/*.tar .
