#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup .. --prefix=/usr --reconfigure
ninja
meson install --destdir=/tmp/stage
rm -r /tmp/stage/usr/share
mkdir -p /tmp/stage/etc/installer/tllist
find /tmp/stage -exec strip --strip-all {} \;
echo 'tllist 1.1.0' > /tmp/stage/etc/installer/tllist/pkinfo
cd $wd
./flashpack /tmp/stage
mv /tmp/stage/*.tar .
