#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
mkdir build
cd build
meson setup .. --prefix=/usr --reconfigure
ninja
meson install --destdir=/tmp/stage
mkdir -p /tmp/stage/etc/installer/sway
find /tmp/stage -name *.so -exec strip --strip-all {} \;
echo 'sway 1.12 musl wlroots pango' > /tmp/stage/etc/installer/sway/pkinfo
cd $wd
./flashpack /tmp/stage
mv /tmp/stage/*.tar .
