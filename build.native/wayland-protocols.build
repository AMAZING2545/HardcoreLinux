

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup .. --reconfigure -Dtests=false -Dprefix=/usr
ninja
meson install --destdir=/tmp/stage
mkdir -p /tmp/stage/etc/installer/wayland-protocols
find /tmp/stage -name *.so -exec strip --strip-all {} \;
echo 'wayland-protocols 1.41' > /tmp/stage/etc/installer/wayland-protocols/pkinfo
cd $wd
./flashpack /tmp/stage
mv /tmp/stage/*.tar .
