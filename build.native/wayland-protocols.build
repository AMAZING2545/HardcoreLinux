#!/bin/sh
set -eu

: "${dir:?set dir to the extracted wayland-protocols source tree}"
: "${YSPM_BIN:=yspm}"
REPO_ROOT="${REPO_ROOT:-.}"
OUT="${OUTPUT:-wayland-protocols-1.45-${ARCH:-x86_64}.yspkg}"
sh "$REPO_ROOT/tools/build-native-meson" "$dir" "$OUT" "wayland-protocols" "1.45" "Wayland protocol extensions"
