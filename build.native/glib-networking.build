#!/bin/sh
set -eu

: "${dir:?set dir to the extracted glib-networking source tree}"
: "${YSPM_BIN:=yspm}"
REPO_ROOT="${REPO_ROOT:-.}"
OUT="${OUTPUT:-glib-networking-2.80.0-${ARCH:-x86_64}.yspkg}"
sh "$REPO_ROOT/tools/build-native-meson" "$dir" "$OUT" "glib-networking" "2.80.0" "GLib networking backends"
