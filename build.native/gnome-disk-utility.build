#!/bin/sh
set -eu

: "${dir:?set dir to the extracted gnome-disk-utility source tree}"
: "${YSPM_BIN:=yspm}"

REPO_ROOT="${REPO_ROOT:-.}"
OUT="${OUTPUT:-gnome-disk-utility-46.1-${ARCH:-x86_64}.yspkg}"

sh "$REPO_ROOT/tools/build-native-meson" "$dir" "$OUT" "gnome-disk-utility" "46.1" "GNOME disk utility"
