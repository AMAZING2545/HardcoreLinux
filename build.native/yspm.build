#!/bin/sh
set -eu

: "${dir:?set dir to the extracted yspm source tree}"
: "${YSPM_BIN:=yspm}"

VERSION="${VERSION:-0.2.0}"
ARCH="${ARCH:-x86_64}"
ABI="${YSPM_ABI:-yspm-abi-1}"
OUT="${OUTPUT:-yspm-${VERSION}-${ARCH}.yspkg}"
STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT

command -v go >/dev/null 2>&1 || {
    echo "yspm.build: Go 1.23+ is required" >&2
    exit 1
}

mkdir -p "$STAGE/usr/bin"
cd "$dir"
CGO_ENABLED=0 go build -trimpath -ldflags '-s -w' -o "$STAGE/usr/bin/yspm" ./cmd/yspm

"$YSPM_BIN" build \
  --root "$STAGE" \
  --output "$OUT" \
  --name yspm \
  --version "$VERSION" \
  --description "Linux system package manager written in Go" \
  --abi "$ABI" \
  --arch "$ARCH" \
  --license GPL-3.0
echo "$OUT"
