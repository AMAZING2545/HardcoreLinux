#!/bin/sh

set -eu

wd=$(pwd)
src=/tmp/yspm-build
stage=/tmp/stage

go_bin=/usr/local/go/bin/go
if [ ! -x "$go_bin" ]; then
    go_bin=$(command -v go || true)
fi
if [ -z "$go_bin" ] || [ ! -x "$go_bin" ]; then
    echo "yspm.build: Go 1.27.1 is required (install the go package first)" >&2
    exit 1
fi

rm -rf "$src" "$stage"
git clone --depth 1 https://github.com/Yassine-Jemi01/yspm.git "$src"
cd "$src"
git checkout --detach 6a7535f6a6206b375eb0e1f6ba7cabc649f69e99

mkdir -p "$stage/usr/bin" "$stage/etc/installer/yspm"

CGO_ENABLED=0 GOTOOLCHAIN=local "$go_bin" build \
    -trimpath \
    -buildvcs=false \
    -ldflags='-s -w' \
    -o "$stage/usr/bin/yspm" \
    ./cmd/yspm

chmod 0755 "$stage/usr/bin/yspm"
printf '%s\n' '#!/bin/sh' 'exit 0' > "$stage/etc/installer/yspm/install"
chmod 0711 "$stage/etc/installer/yspm/install"
printf '%s\n' 'yspm 0.2.0 go' > "$stage/etc/installer/yspm/pkinfo"
printf '%s\n' '#!/bin/sh' 'rm -f /usr/bin/yspm' > "$stage/etc/installer/yspm/uninstall"
chmod 0711 "$stage/etc/installer/yspm/uninstall"

cd "$wd"
./flashpack "$stage"
cp "$stage"/*.tar .
rm -rf "$src"
