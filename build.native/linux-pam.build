#!/bin/sh
set -eu

: "${dir:?set dir to the extracted linux-pam source tree}"
: "${YSPM_BIN:=yspm}"
REPO_ROOT="${REPO_ROOT:-.}"
OUT="${OUTPUT:-linux-pam-1.7.0-${ARCH:-x86_64}.yspkg}"
sh "$REPO_ROOT/tools/build-native-configure" "$dir" "$OUT" "linux-pam" "1.7.0" "Linux Pluggable Authentication Modules"
