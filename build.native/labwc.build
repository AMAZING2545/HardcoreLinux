#!/bin/sh
set -eu

: "${dir:?set dir to the extracted labwc source tree}"
: "${YSPM_BIN:=yspm}"

VERSION="${VERSION:-0.20.2}"
ARCH="${ARCH:-x86_64}"
ABI="${YSPM_ABI:-yspm-abi-1}"
OUT="${OUTPUT:-labwc-${VERSION}-${ARCH}.yspkg}"
STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT

cd "$dir"
rm -rf build
meson setup build --prefix=/usr -Dman-pages=disabled
ninja -C build
DESTDIR="$STAGE" meson install -C build

"$YSPM_BIN" build \
  --root "$STAGE" \
  --output "$OUT" \
  --name labwc \
  --version "$VERSION" \
  --description "Wayland stacking compositor inspired by Openbox" \
  --abi "$ABI" \
  --arch "$ARCH" \
  --license GPL-2.0
echo "$OUT"
