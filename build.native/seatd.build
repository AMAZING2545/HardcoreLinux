#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
mkdir build
cd build
meson setup .. --prefix=/usr --reconfigure
ninja
meson install --destdir=/tmp/stage
rm -r /tmp/stage/usr/share
mkdir -p /tmp/stage/etc/installer/seatd
find /tmp/stage -name *.so -exec strip --strip-all {} \;
echo 'seatd 0.9.3 musl' > /tmp/stage/etc/installer/seatd/pkinfo
cd $wd
./flashpack /tmp/stage
mv /tmp/stage/*.tar .
