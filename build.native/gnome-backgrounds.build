#!/bin/sh
set -eu

: "${dir:?set dir to the extracted gnome-backgrounds source tree}"
: "${YSPM_BIN:=yspm}"

REPO_ROOT="${REPO_ROOT:-.}"
OUT="${OUTPUT:-gnome-backgrounds-51.0-${ARCH:-x86_64}.yspkg}"
sh "$REPO_ROOT/tools/build-native-meson"  "$dir" "$OUT" "gnome-backgrounds" "51.0" "GNOME desktop backgrounds"
