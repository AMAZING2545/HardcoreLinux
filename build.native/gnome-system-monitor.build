#!/bin/sh
set -eu

: "${dir:?set dir to the extracted gnome-system-monitor source tree}"
: "${YSPM_BIN:=yspm}"

REPO_ROOT="${REPO_ROOT:-.}"
OUT="${OUTPUT:-gnome-system-monitor-47.0-${ARCH:-x86_64}.yspkg}"
sh "$REPO_ROOT/tools/build-native-meson"  "$dir" "$OUT" "gnome-system-monitor" "47.0" "GNOME system monitor"
