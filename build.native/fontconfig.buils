

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup .. --prefix=/usr --reconfigure -Dtests=disabled -Dnls=disabled
ninja
meson install --destdir=/tmp/stage
mkdir -p /tmp/stage/etc/installer/fontconfig
find /tmp/stage -name *.so -exec strip --strip-all {} \;
echo 'fontconfig 2.18.2 musl json-c freetype expat' > /tmp/stage/etc/installer/fontconfig/pkinfo
rm -rf /tmp/stage/usr/share/man
rm -rf /tmp/stage/usr/share/info
rm -rf /tmp/stage/usr/share/doc
cd $wd
./flashpack /tmp/stage
mv /tmp/stage/*.tar .
