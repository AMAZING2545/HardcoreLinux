#!/bin/sh
wd=$(pwd)
cd $dir
rm -rf /tmp/stage
mkdir build
cd build
meson .. --prefix=/usr --wipe -Dc_link_args="-Wl,-rpath-link,src/GLdispatch"
ninja
meson install --destdir=/tmp/stage
rm -r /tmp/stage/usr/share
mkdir -p /tmp/stage/etc/installer/libglvnd
find /tmp/stage -name *.so -exec strip --strip-all {} \;
echo 'libglvnd 1.7.0 musl' > /tmp/stage/etc/installer/libglvnd/pkinfo
cd $wd
./flashpack /tmp/stage
mv /tmp/stage/*.tar .
