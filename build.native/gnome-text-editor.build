#!/bin/sh
set -eu

: "${dir:?set dir to the extracted gnome-text-editor source tree}"
: "${YSPM_BIN:=yspm}"

REPO_ROOT="${REPO_ROOT:-.}"
OUT="${OUTPUT:-gnome-text-editor-48.2-${ARCH:-x86_64}.yspkg}"
sh "$REPO_ROOT/tools/build-native-meson"  "$dir" "$OUT" "gnome-text-editor" "48.2" "GNOME text editor"
