

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage build
mkdir build
cd build
meson setup .. --prefix=/usr -Ddebug-gui=false -Dmtdev=false -Dlibwacom=false
ninja
meson install --destdir=/tmp/stage
rm -r /tmp/stage/usr/share
mkdir -p /tmp/stage/etc/installer/libinput
find /tmp/stage -name *.so -exec strip --strip-all {} \;
echo 'libinput 1.31 musl libevdev udev' > /tmp/stage/etc/installer/libinput/pkinfo
cd $wd
./flashpack /tmp/stage
mv /tmp/stage/*.tar .
