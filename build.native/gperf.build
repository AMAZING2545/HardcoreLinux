

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
./configure --prefix=/usr
make -j$(nproc)
make DESTDIR=/tmp/stage install
rm -rf /tmp/stage/usr/share
mkdir -p /tmp/stage/etc/installer/gperf
find /tmp/stage -name *.so -exec strip --strip-all {} \;
find /tmp/stage -name *.la -exec rm {} \;
echo 'gperf 3.3 musl' > /tmp/stage/etc/installer/gperf/pkinfo
cd $wd
./flashpack /tmp/stage
mv /tmp/stage/*.tar .
