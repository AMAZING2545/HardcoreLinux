#!/bin/sh
set -eu

: "${dir:?set dir to the extracted gnome-software source tree}"
: "${YSPM_BIN:=yspm}"

REPO_ROOT="${REPO_ROOT:-.}"
OUT="${OUTPUT:-gnome-software-51.0-${ARCH:-x86_64}.yspkg}"

sh "$REPO_ROOT/tools/build-native-meson" "$dir" "$OUT" "gnome-software" "51.0" "GNOME graphical software center"
