#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup --prefix=/usr -Dexamples=false -Dtests=false --wipe
ninja
meson install --destdir=/tmp/stage
mkdir -p /tmp/stage/etc/installer/fuse
find /tmp/stage -name '*.so*' -exec strip --strip-all {} \;
echo 'fuse 3.18.2 musl' > /tmp/stage/etc/installer/fuse/pkinfo
cd $wd
./flashpack /tmp/stage
mv /tmp/stage/*.tar .
