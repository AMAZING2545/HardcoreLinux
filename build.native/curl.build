#!/bin/sh

echo $dir
wd=$(pwd)
cd $dir
make SHELL=/bin/sh distclean
rm -r /tmp/stage
./configure CC="cc" --prefix=/usr --with-openssl --without-libpsl --disable-dependency-tracking
make  SHELL=/bin/sh -j$(nproc)
make SHELL=/bin/sh DESTDIR=/tmp/stage install -j2
mkdir -p /tmp/stage/etc/installer/curl
echo "curl 8.21.0 openssl musl" > /tmp/stage/etc/installer/curl/pkinfo
for file in $(find /tmp/stage -type f); do if [ -x $file ]; then strip $file; fi; done
cd $wd
./flashpack /tmp/stage
cp /tmp/stage/*.tar .
