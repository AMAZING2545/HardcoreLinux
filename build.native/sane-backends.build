#!/bin/sh
set -eu

: "${dir:?set dir to the extracted sane-backends source tree}"
: "${YSPM_BIN:=yspm}"
REPO_ROOT="${REPO_ROOT:-.}"
OUT="${OUTPUT:-sane-backends-1.2.1-${ARCH:-x86_64}.yspkg}"
sh "$REPO_ROOT/tools/build-native-configure" "$dir" "$OUT" "sane-backends" "1.2.1" "Scanner access backend collection"
