#!/bin/sh
set -eu

: "${dir:?set dir to the extracted cups-pk-helper source tree}"
: "${YSPM_BIN:=yspm}"
REPO_ROOT="${REPO_ROOT:-.}"
OUT="${OUTPUT:-cups-pk-helper-0.2.7-${ARCH:-x86_64}.yspkg}"
sh "$REPO_ROOT/tools/build-native-meson" "$dir" "$OUT" "cups-pk-helper" "0.2.7" "GNOME printing privilege helper"
