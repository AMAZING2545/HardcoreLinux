#!/bin/sh

## must be built on Alpine or Hardcore

echo $dir
wd=$(pwd)
cd $dir
mkdir -p /tmp/stage/etc/installer/sudo /tmp/stage/usr/bin/
gcc -Os sudo.c -o /tmp/stage/usr/bin/sudo
echo "simpleSUdo 0.0.1 musl" > /tmp/stage/etc/installer/sudo/pkinfo
for file in $(find /tmp/stage -type f); do if [ -x $file ]; then strip $file; fi; done
cd $wd
./flashpack /tmp/stage
cp /tmp/stage/*.tar .
