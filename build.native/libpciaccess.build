

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
mkdir build
cd build
meson setup --reconfigure -Dprefix=/usr
ninja
meson install --destdir=/tmp/stage
mkdir -p /tmp/stage/etc/installer/libpciaccess
find /tmp/stage -name *.so -exec strip --strip-all {} \;
echo 'libpciaccess 0.11.1 musl zlib' > /tmp/stage/etc/installer/libpciaccess/pkinfo
cd $wd
./flashpack /tmp/stage
mv /tmp/stage/*.tar .
