#!/bin/sh
set -eu

: "${dir:?set dir to the extracted power-profiles-daemon source tree}"
: "${YSPM_BIN:=yspm}"
REPO_ROOT="${REPO_ROOT:-.}"
OUT="${OUTPUT:-power-profiles-daemon-0.30-${ARCH:-x86_64}.yspkg}"
sh "$REPO_ROOT/tools/build-native-meson" "$dir" "$OUT" "power-profiles-daemon" "0.30" "Laptop power profile service"
