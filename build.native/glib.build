#!/bin/sh
set -eu

: "${dir:?set dir to the extracted glib source tree}"
: "${YSPM_BIN:=yspm}"

REPO_ROOT="${REPO_ROOT:-.}"
VERSION="${VERSION:-2.89.3}"
OUT="${OUTPUT:-glib-${VERSION}-${ARCH:-x86_64}.yspkg}"

sh "$REPO_ROOT/tools/build-native-meson" "$dir" "$OUT" glib "$VERSION" "GLib core utility library"
