

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup .. -Dprefix=/usr --reconfigure
ninja
meson install --destdir=/tmp/stage

mkdir -p /tmp/stage/etc/installer/libcairo
find /tmp/stage -name *.so -exec strip --strip-all {} \;
echo 'libcairo_png 1.18.4 musl zlib pixman' > /tmp/stage/etc/installer/libcairo/pkinfo

cd $wd
./flashpack /tmp/stage
mv /tmp/stage/*.tar .
