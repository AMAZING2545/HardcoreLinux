

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup .. --prefix=/usr --reconfigure --buildtype=release -Dintrospection=disabled -Dgtk_doc=false -Dc_link_args="-Wl,-rpath-link,pango"
ninja
meson install --destdir=/tmp/stage

mkdir -p /tmp/stage/etc/installer/pango
find /tmp/stage -name *.so -exec strip --strip-all {} \;
echo 'pango 1.58.2 musl zlib pixman libcairo glib fribidi fontconfig expat libffi' > /tmp/stage/etc/installer/pango/pkinfo

cd $wd
./flashpack /tmp/stage
mv /tmp/stage/*.tar .
