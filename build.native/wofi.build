#!/bin/sh
set -eu

: "${dir:?set dir to the extracted wofi source tree}"
: "${YSPM_BIN:=yspm}"

VERSION="${VERSION:-git}"
ARCH="${ARCH:-x86_64}"
ABI="${YSPM_ABI:-yspm-abi-1}"
OUT="${OUTPUT:-wofi-${VERSION}-${ARCH}.yspkg}"
STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT

cd "$dir"
rm -rf build
meson setup build --prefix=/usr -Dtests=false
ninja -C build
DESTDIR="$STAGE" meson install -C build

"$YSPM_BIN" build \
  --root "$STAGE" \
  --output "$OUT" \
  --name wofi \
  --version "$VERSION" \
  --description "Wayland launcher and menu" \
  --abi "$ABI" \
  --arch "$ARCH" \
  --license GPL-3.0
echo "$OUT"
