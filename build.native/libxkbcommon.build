#!/bin/sh
set -eu

: "${dir:?set dir to the extracted libxkbcommon source tree}"
: "${YSPM_BIN:=yspm}"
REPO_ROOT="${REPO_ROOT:-.}"
OUT="${OUTPUT:-libxkbcommon-1.11.0-${ARCH:-x86_64}.yspkg}"
sh "$REPO_ROOT/tools/build-native-meson" "$dir" "$OUT" "libxkbcommon" "1.11.0" "Keyboard handling library for Wayland and X11"
