#!/bin/sh
set -u

echo "Obsidian Core Linux init"

if grep -qw 'obsidian.recovery=1' /proc/cmdline 2>/dev/null; then
    echo "[  ok  ] recovery mode requested"
    exec /usr/bin/hc-recovery
fi

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sys /sys 2>/dev/null || true
mkdir -p /dev/pts /dev/mqueue /run /tmp /system/tmp /run/user
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t mqueue mqueue /dev/mqueue 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true
mount -t tmpfs tmpfs /tmp 2>/dev/null || true
chmod 1777 /tmp 2>/dev/null || true

[ -f /etc/profile ] && . /etc/profile
[ -f /etc/hostname ] && hostname "$(cat /etc/hostname)" 2>/dev/null || true

echo "[  ok  ] mounted VFS nodes"

if [ -w /proc/sys/kernel/hotplug ]; then
    echo "/sbin/mdev" > /proc/sys/kernel/hotplug
fi
if command -v udevadm >/dev/null 2>&1 && pidof udevd >/dev/null 2>&1; then
    udevadm trigger --action=add >/dev/null 2>&1 || true
    udevadm settle >/dev/null 2>&1 || true
    echo "[  ok  ] populated /dev with udev"
elif command -v mdev >/dev/null 2>&1; then
    mdev -s >/dev/null 2>&1 || true
    echo "[  ok  ] populated /dev with mdev"
fi

if [ -f /system/drivers/modprobe ] && command -v modprobe >/dev/null 2>&1; then
    echo "loading configured kernel modules"
    while IFS= read -r driver; do
        [ -n "$driver" ] || continue
        driver="${driver#??????}"
        echo "[  ok  ] loading $driver"
        modprobe "$driver" 2>/dev/null || echo "[ warn ] could not load $driver"
    done < /system/drivers/modprobe
fi

: > /system/tmp/services

echo "executing boot scripts"
if [ -d /system/scripts ]; then
    for script in /system/scripts/*; do
        [ -f "$script" ] || continue
        chmod 0755 "$script" 2>/dev/null || true
        echo "[  ok  ] script ${script##*/}"
        setsid "$script" >/dev/null 2>&1 &
        sleep 0.05
    done
fi

start_service() {
    name="$1"
    service="/system/services/$name"
    [ -x "$service" ] || return 1
    if grep -qxF "$name" /system/tmp/services 2>/dev/null; then
        return 0
    fi
    echo "$name" >> /system/tmp/services
    echo "[  ok  ] starting service $name"
    setsid "$service" >/tmp/service-"$name".log 2>&1 &
}

echo "starting enabled services"
if [ -f /system/enabled-services ]; then
    while IFS= read -r service; do
        [ -n "$service" ] || continue
        start_service "$service" || echo "[ warn ] service unavailable: $service"
    done < /system/enabled-services
fi

if [ -f /etc/hc-live ]; then
    echo "[  ok  ] live environment"
    echo "[  ok  ] starting installer on tty1"
    setsid sh /usr/sbin/hc-installer </dev/tty1 >/dev/tty1 2>&1 &
fi

if [ ! -f /etc/hc-live ]; then
    if command -v gdm >/dev/null 2>&1; then
        echo "[  ok  ] starting gdm"
        exec gdm
    fi
    if command -v ly >/dev/null 2>&1; then
        echo "[  ok  ] starting ly"
        exec ly
    fi
fi

echo "starting tty login"
for tty in tty1 tty2 tty3 tty4 tty5 tty6; do
    if [ "$tty" = tty1 ] && [ -f /etc/hc-live ]; then
        continue
    fi
    (
        while :; do
            getty 0 "$tty"
            sleep 1
        done
    ) &
done

while :; do
    sleep 100
done
