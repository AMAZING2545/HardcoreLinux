#!/bin/bash

wd=$(pwd)
cd $dir
rm -r /tmp/stage*
#make distclean
#./Configure linux-x86_64 --prefix=/usr --libdir=/usr/lib --openssldir=/etc/ssl
#make CC="musl-gcc" CFLAGS="-nostdinc --sysroot=${ROOTFS} -isystem ${ROOTFS}/usr/include -I${ROOTFS}/usr/include -Oz" LDFLAGS="--sysroot=${ROOTFS} -L${ROOTFS}/lib -L${ROOTFS}/usr/lib" -j$(nproc)
make CC="musl-gcc" DESTDIR=/tmp/stage install_sw -j$(nproc)
make DESTDIR=/tmp/stage install_ssldirs

mkdir -p /tmp/stage2/usr/lib /tmp/stage/etc/installer/openssl /tmp/stage2/etc/installer/devopenssl
mv /tmp/stage/usr/include /tmp/stage2/usr
mv /tmp/stage/usr/lib/*.a /tmp/stage2/usr/lib
echo "openssl 3.5.7 musl" > /tmp/stage/etc/installer/openssl/pkinfo
echo "devopenssl 3.5.7 openssl" > /tmp/stage2/etc/installer/devopenssl/pkinfo
cd $wd
./flashpack /tmp/stage
./flashpack /tmp/stage2
cp /tmp/stage/openssl.tar /tmp/stage2/devopenssl.tar .
