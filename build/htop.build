#!/bin/bash

wd=$(pwd)
cd $dir
rm -r /tmp/stage
./configure CC="musl-gcc" CFLAGS="-nostdinc --sysroot=${ROOTFS} -isystem ${ROOTFS}/usr/include -I${ROOTFS}/usr/include -Ofast" LDFLAGS="--sysroot=${ROOTFS} -L${ROOTFS}/lib -L${ROOTFS}/usr/lib" --with-libunwind --enable-backtrace=unwind-ptrace --enable-affinity --host=x86_64-pc-linux-musl --prefix=/usr
make -j$(nproc)
make DESTDIR=/tmp/stage install -j2
mkdir -p /tmp/stage/etc/installer/htop 
echo "htop 3.5.2 musl ncurses libunwind" > /tmp/stage/etc/installer/htop/pkinfo
rm -r /tmp/stage/usr/share/man
for file in $(find /tmp/stage -type f); do if [ -x $file ]; then strip $file; fi; done
cd $wd
./flashpack /tmp/stage
cp /tmp/stage/*.tar .
