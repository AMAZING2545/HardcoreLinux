#!/bin/sh
set -eu

[ "$(id -u)" = 0 ] || {
    echo "rootfs.build: must run as root" >&2
    exit 1
}

BUILD_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
REPO_DIR=$(CDPATH= cd -- "$BUILD_DIR/.." && pwd)
ARCHIVE_DIR="${YSPM_ARCHIVE_DIR:-$REPO_DIR/repo}"
ROOTFS="${ROOTFS:-$BUILD_DIR/rootfs}"
OUTPUT="${OUTPUT:-$BUILD_DIR/rootfs.tar}"
DISTRO_VERSION="${DISTRO_VERSION:-0.3.0}"

extract_if_present() {
    archive="$1"
    source="$ARCHIVE_DIR/$archive"
    if [ -f "$source" ]; then
        echo "extracting $source"
        tar -xpzf "$source" -C "$ROOTFS"
    else
        echo "skipping missing archive: $source"
    fi
}

rm -rf "$ROOTFS"
rm -f "$OUTPUT"
mkdir -p "$ROOTFS"

for archive in \
    devmusl.tar musl.tar devlinux.tar terminfo.tar openssl.tar busybox.tar \
    ncurses6.tar zlib.tar devncurses6.tar libalsa.tar alsautils.tar \
    libunwind.tar devlibunwind.tar htop.tar nano.tar popt.tar \
    deve2fsprogs.tar e2fsprogs.tar gfdisk.tar libgcc.tar libstdc++.tar; do
    extract_if_present "$archive"
done

if [ -d "$BUILD_DIR/udhcpc" ]; then
    mkdir -p "$ROOTFS/usr/share"
    cp -a "$BUILD_DIR/udhcpc" "$ROOTFS/usr/share/"
fi

mkdir -p "$ROOTFS/etc" "$ROOTFS/usr/bin" "$ROOTFS/usr/sbin" "$ROOTFS/sbin"
mkdir -p "$ROOTFS/system/services" "$ROOTFS/system/scripts" "$ROOTFS/system/drivers"
mkdir -p "$ROOTFS/system/tmp" "$ROOTFS/var/lib/yspm" "$ROOTFS/var/cache/yspm"
mkdir -p "$ROOTFS/etc/yspm" "$ROOTFS/etc/profile.d" "$ROOTFS/run/user"
mkdir -p "$ROOTFS/usr/share/obsidian-core-linux/profiles"

cp "$BUILD_DIR/rootfs_build/init" "$ROOTFS/etc/init"
cp "$BUILD_DIR/rootfs_build/initctl" "$ROOTFS/sbin/initctl"
cp -a "$BUILD_DIR/rootfs_build/scripts/." "$ROOTFS/system/scripts/"
if [ -d "$BUILD_DIR/rootfs_build/services" ]; then
    cp -a "$BUILD_DIR/rootfs_build/services/." "$ROOTFS/system/services/"
fi
if [ -d "$BUILD_DIR/rootfs_build/drivers" ]; then
    cp -a "$BUILD_DIR/rootfs_build/drivers/." "$ROOTFS/system/drivers/"
fi
cp "$REPO_DIR/profiles/gnome.packages" "$ROOTFS/usr/share/obsidian-core-linux/profiles/gnome.packages"
cp "$REPO_DIR/profiles/minimal-desktop.packages" "$ROOTFS/usr/share/obsidian-core-linux/profiles/minimal-desktop.packages"
chmod 0755 "$ROOTFS/etc/init" "$ROOTFS/sbin/initctl"
for tree in "$ROOTFS/system/services" "$ROOTFS/system/scripts" "$ROOTFS/system/drivers"; do
    if [ -d "$tree" ]; then
        find "$tree" -type f -print | while IFS= read -r file; do
            chmod 0755 "$file"
        done
    fi
done
printf '%s\n' 'udev
dbus
elogind
polkit
NetworkManager' > "$ROOTFS/system/enabled-services"
: > "$ROOTFS/system/tmp/services"

if [ -n "${YSPM_BIN:-}" ]; then
    test -f "$YSPM_BIN" || {
        echo "rootfs.build: YSPM_BIN does not exist: $YSPM_BIN" >&2
        exit 1
    }
    cp "$YSPM_BIN" "$ROOTFS/usr/bin/yspm"
else
    YSPM_OUTPUT="/tmp/yspm" \
    YSPM_REF="${YSPM_REF:-824b39de2758f5434889b7814888cad2f6a4f16a}" \
    sh "$REPO_DIR/tools/build-yspm" >/dev/null
    cp /tmp/yspm "$ROOTFS/usr/bin/yspm"
fi
chmod 0755 "$ROOTFS/usr/bin/yspm"

cp "$REPO_DIR/tools/hc-installer" "$ROOTFS/usr/sbin/hc-installer"
cp "$REPO_DIR/tools/hc-setup-desktop" "$ROOTFS/usr/sbin/hc-setup-desktop"
cp "$REPO_DIR/tools/hc-setup-gnome" "$ROOTFS/usr/sbin/hc-setup-gnome"
cp "$REPO_DIR/tools/hc-doctor" "$ROOTFS/usr/bin/hc-doctor"
cp "$REPO_DIR/tools/hc-recovery" "$ROOTFS/usr/bin/hc-recovery"
cp "$REPO_DIR/tools/obsidian-first-login" "$ROOTFS/usr/bin/obsidian-first-login"
cp "$REPO_DIR/tools/bench-system" "$ROOTFS/usr/bin/hc-bench"
chmod 0755 "$ROOTFS/usr/sbin/hc-installer" "$ROOTFS/usr/sbin/hc-setup-desktop" "$ROOTFS/usr/sbin/hc-setup-gnome" "$ROOTFS/usr/bin/hc-doctor" "$ROOTFS/usr/bin/hc-recovery" "$ROOTFS/usr/bin/obsidian-first-login" "$ROOTFS/usr/bin/hc-bench"

mkdir -p "$ROOTFS/etc/ssl/certs"
if command -v wget >/dev/null 2>&1; then
    wget -q https://curl.se/ca/cacert.pem -O "$ROOTFS/etc/ssl/certs/ca-certificates.crt" || true
fi

mkdir -p "$ROOTFS/home" "$ROOTFS/root" "$ROOTFS/tmp"
mkdir -p "$ROOTFS/etc/xdg/autostart"
cp "$REPO_DIR/build/rootfs_build/xdg/autostart/obsidian-first-login.desktop" "$ROOTFS/etc/xdg/autostart/obsidian-first-login.desktop"
cp "$REPO_DIR/build/rootfs_build/etc/chrony.conf" "$ROOTFS/etc/chrony.conf"
cp "$REPO_DIR/build/rootfs_build/etc/nftables.conf" "$ROOTFS/etc/nftables.conf"
printf '%s\n' 'root:x:0:0:root:/root:/bin/sh' > "$ROOTFS/etc/passwd"
printf '%s\n' 'root:x:0:' > "$ROOTFS/etc/group"
printf '%s\n' 'root:!:1:0:99999:7:::' > "$ROOTFS/etc/shadow"
chmod 0644 "$ROOTFS/etc/passwd" "$ROOTFS/etc/group"
chmod 0600 "$ROOTFS/etc/shadow"

printf '%s\n' 'nameserver 1.1.1.1' > "$ROOTFS/etc/resolv.conf"

cat > "$ROOTFS/etc/profile" <<'EOF'
export LD_LIBRARY_PATH="/usr/lib:/lib"
export PATH="/bin:/sbin:/usr/bin:/usr/sbin"
export SSL_CERT_FILE="/etc/ssl/certs/ca-certificates.crt"
[ -f /etc/yspm/env ] && . /etc/yspm/env
[ -f /etc/profile.d/20-desktop.sh ] && . /etc/profile.d/20-desktop.sh
EOF

cat > "$ROOTFS/etc/profile.d/yspm.sh" <<'EOF'
[ -f /etc/yspm/env ] && . /etc/yspm/env
EOF

YSPM_REPOSITORY_URL="${YSPM_REPOSITORY_URL:-https://github.com/Yassine-Jemi01/ObsidianCoreLinux/releases/latest/download/repo-index.json}"
cat > "$ROOTFS/etc/yspm/env" <<EOF
export YSPM_REPOSITORY='$YSPM_REPOSITORY_URL'
export YSPM_ROOT='/'
export YSPM_DATA_DIR='/var/lib/yspm'
export YSPM_CACHE_DIR='/var/cache/yspm'
EOF

cat > "$ROOTFS/etc/os-release" <<EOF
NAME="Obsidian Core Linux"
VERSION="$DISTRO_VERSION"
ID=obsidiancore
ID_LIKE=alpine
PRETTY_NAME="Obsidian Core Linux $DISTRO_VERSION"
ANSI_COLOR="36"
HOME_URL="https://github.com/Yassine-Jemi01/ObsidianCoreLinux"
BUG_REPORT_URL="https://github.com/Yassine-Jemi01/ObsidianCoreLinux/issues"
EOF

: > "$ROOTFS/etc/hc-live"

tar -cpzf "$OUTPUT" -C "$ROOTFS" .
echo "root filesystem: $OUTPUT"
