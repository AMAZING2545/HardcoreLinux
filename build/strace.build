#!/bin/bash

wd=$(pwd)
cd $dir
rm -r /tmp/stage
make distclean
CC="musl-gcc -nostdinc --sysroot=${ROOTFS} -isystem ${ROOTFS}/usr/include -I${ROOTFS}/usr/include -Ofast" LDFLAGS="--sysroot=${ROOTFS} -L${ROOTFS}/lib -L${ROOTFS}/usr/lib" ./configure     --prefix=/usr  --host=x86_64-linux-musl --target=x86_64-linux-musl --with-libunwind --disable-mpers
make -j$(nproc)
make DESTDIR=/tmp/stage install -j2
mkdir -p /tmp/stage/etc/installer/strace
echo "strace 7.1 musl libunwind" > /tmp/stage/etc/installer/strace/pkinfo
rm -r /tmp/stage/usr/share
for file in $(find /tmp/stage -type f); do if [ -x $file ]; then strip $file; fi; done
cd $wd
./flashpack /tmp/stage
cp /tmp/stage/*.tar .
