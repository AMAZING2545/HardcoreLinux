#!/bin/bash

wd=$(pwd)
cd $dir
rm -r /tmp/stage*
rm $wd/binutils.tar
#make distclean -j2
CC="musl-gcc" CFLAGS="-nostdinc --sysroot=${ROOTFS} -isystem ${ROOTFS}/usr/include -I${ROOTFS}/usr/include -Ofast" LDFLAGS="--sysroot=${ROOTFS} -L${ROOTFS}/lib -L${ROOTFS}/usr/lib" CXX="" ./configure --prefix=/usr --disable-debug --disable-dependency-tracking
make -j$(nproc)
make DESTDIR=/tmp/stage install -j$(nproc)
mkdir -p /tmp/stage/etc/installer/libnl
mkdir -p /tmp/stage2/etc/installer/devlibnl /tmp/stage2/usr/lib
mkdir -p /tmp/stage3/etc/installer/binlibnl /tmp/stage3/usr
echo "libnl 3.12.0 musl" > /tmp/stage/etc/installer/libnl/pkinfo
echo "devlibnl 3.12.0 musl libnl" > /tmp/stage2/etc/installer/devlibnl/pkinfo
echo "binlibnl 3.12.0 musl libnl" > /tmp/stage3/etc/installer/binlibnl/pkinfo
rm -r /tmp/stage/usr/lib/libnl/
rm -r /tmp/stage/usr/share
mv /tmp/stage/usr/etc /tmp/stage/
mv /tmp/stage/usr/bin /tmp/stage3/usr
mv /tmp/stage/usr/include /tmp/stage2/usr
mv /tmp/stage/usr/lib/*.a /tmp/stage2/usr/lib
rm /tmp/stage/usr/lib/*.la

for file in $(find /tmp/stage -type f); do if [ -x $file ]; then strip $file; fi; done
for file in $(find /tmp/stage3 -type f); do if [ -x $file ]; then strip $file; fi; done

cd $wd
./flashpack /tmp/stage
./flashpack /tmp/stage2
./flashpack /tmp/stage3
cp /tmp/stage*/*.tar .
