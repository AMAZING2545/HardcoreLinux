#!/bin/bash

rm -r /tmp/stage*
wd=$(pwd)
cd $dir
if [ $(whoami) != "root" ]; then echo must be root; exit -1; fi
./configure --disable-tests --prefix=/usr --disable-dependency-tracking --enable-coredump --enable-ptrace --enable-setjmp CC="musl-gcc" CFLAGS="-nostdinc --sysroot=${ROOTFS} -isystem ${ROOTFS}/usr/include -I${ROOTFS}/usr/include -Ofast" LDFLAGS="--sysroot=${ROOTFS} -L${ROOTFS}/lib -L${ROOTFS}/usr/lib" --host=x86_64-pc-linux-musl
rm -r /tmp/stage
make DESTDIR=/tmp/stage install -j2
strip /tmp/stage/usr/lib/*.so*
mkdir -p /tmp/stage2/usr/lib
mv /tmp/stage/usr/lib/*.a /tmp/stage2/usr/lib
mv /tmp/stage/usr/include /tmp/stage2/usr
mkdir -p /tmp/stage/etc/installer/libunwind /tmp/stage2/etc/installer/devlibunwind
echo "libunwind 1.8.3 musl" > /tmp/stage/etc/installer/libunwind/pkinfo
echo "devlibunwind 1.8.3 libunwind" > /tmp/stage2/etc/installer/devlibunwind/pkinfo
touch /tmp/stage/etc/installer/libunwind/install /tmp/stage2/etc/installer/devlibunwind/install
echo '#!/bin/sh' > /tmp/stage/etc/installer/libunwind/install
echo '#!/bin/sh' > /tmp/stage2/etc/installer/devlibunwind/install
$wd/flashpack /tmp/stage
$wd/flashpack /tmp/stage2
ls /tmp/stage*
cd $wd
cp /tmp/stage*/*.tar .
