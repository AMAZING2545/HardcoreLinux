#!/bin/bash

cd $1


touch etc/installer/$(ls etc/installer/)/uninstall
printf '%s' "$(for i in $(find -type f,l);do echo "rm ${i:1}";done)" >> etc/installer/$(ls etc/installer/)/uninstall
echo -e "\n" >> etc/installer/$(ls etc/installer/)/uninstall
printf '%s' "$(for i in $(find -type d);do echo "rmdir ${i:1}";done)" >> etc/installer/$(ls etc/installer/)/uninstall

tar -cpz $(ls) -f "$(ls etc/installer).tar"
