#!/bin/sh
set -eu

die() { printf 'installer: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"; }
ask() {
    prompt="$1"
    default="${2:-}"
    printf '%s' "$prompt"
    [ -n "$default" ] && printf ' [%s]' "$default"
    printf ': '
    IFS= read -r answer || true
    [ -n "$answer" ] || answer="$default"
    printf '%s' "$answer"
}
yesno() {
    prompt="$1"
    default="${2:-n}"
    while :; do
        ans=$(ask "$prompt (y/n)" "$default")
        case "$ans" in
            y|Y|yes|YES) return 0 ;;
            n|N|no|NO) return 1 ;;
        esac
        printf 'Please answer y or n.\n'
    done
}
confirm_disk() {
    disk="$1"
    printf '\n%s\n' "Final safety check: this will erase $disk."
    printf '%s\n' "Type ERASE $disk exactly to continue:"
    IFS= read -r confirmation || true
    [ "$confirmation" = "ERASE $disk" ] || die "disk erase confirmation did not match; installation cancelled"
}

[ "$(id -u)" = 0 ] || die "run this installer as root"
need tar
need mount
need umount
need lsblk
need blkid
need chroot
need mkfs.ext4
need dd

printf '\033c'
printf '%s\n' 'Obsidian Core Linux installer'
printf '%s\n\n' 'The installer uses the embedded UEFI bootloader shipped in this ISO.'
printf '%s\n' 'Review every value carefully. Guided installation erases the selected disk.'
printf '%s\n' 'Detected disks:'
lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS
printf '\n'

EFI_IMAGE=/boot/efi.img
BOOTLOADER=/boot/BOOTX64.EFI
[ -f "$EFI_IMAGE" ] || die "embedded EFI system partition image not found: $EFI_IMAGE"
[ -f "$BOOTLOADER" ] || die "embedded UEFI bootloader not found: $BOOTLOADER"

MODE=$(ask 'Installation mode (guided/manual)' 'guided')
case "$MODE" in
    guided)
        need gdisk
        DISK=$(ask 'Target disk, e.g. /dev/sda')
        [ -b "$DISK" ] || die "not a block device: $DISK"

        DISK_TYPE=$(lsblk -dn -o TYPE "$DISK" 2>/dev/null || true)
        [ "$DISK_TYPE" = "disk" ] || die "target must be a whole disk, not a partition: $DISK"

        DISK_RO=$(lsblk -dn -o RO "$DISK" 2>/dev/null || true)
        [ "$DISK_RO" = "0" ] || die "target disk is read-only: $DISK"

        DISK_MOUNTS=$(lsblk -nr -o MOUNTPOINT "$DISK" 2>/dev/null | sed '/^$/d' || true)
        [ -z "$DISK_MOUNTS" ] || die "target disk has mounted filesystems; unmount them first"

        printf '%s\n' 'Selected target:'
        lsblk -dn -o NAME,SIZE,MODEL,TRAN,RO "$DISK"
        confirm_disk "$DISK"

        printf '%s\n' 'Writing a GPT layout: 512 MiB EFI + remaining space for Linux...'
        printf 'o\ny\nn\n1\n\n+512M\nEF00\nn\n2\n\n\n8300\nw\ny\n' | gdisk "$DISK"
        case "$DISK" in
            *nvme*|*mmcblk*) ESP="${DISK}p1"; ROOT="${DISK}p2" ;;
            *) ESP="${DISK}1"; ROOT="${DISK}2" ;;
        esac
        sleep 1
        [ -b "$ESP" ] || die "EFI partition was not created: $ESP"
        [ -b "$ROOT" ] || die "root partition was not created: $ROOT"

        ESP_IMAGE_SIZE=$(wc -c < "$EFI_IMAGE")
        ESP_SIZE=$(lsblk -bn -o SIZE "$ESP" 2>/dev/null | tr -d ' ' || true)
        [ -n "$ESP_SIZE" ] || die "could not determine EFI partition size"
        [ "$ESP_SIZE" -ge "$ESP_IMAGE_SIZE" ] || die "EFI partition is smaller than the embedded boot image"

        printf '%s\n' 'Installing embedded EFI filesystem...'
        dd if="$EFI_IMAGE" of="$ESP" bs=4M conv=fsync,status=none
        mkfs.ext4 -F -L OBSIDIAN "$ROOT"
        ;;
    manual)
        ESP=$(ask 'EFI system partition')
        ROOT=$(ask 'Linux root partition')
        [ -b "$ESP" ] || die "not a block device: $ESP"
        [ -b "$ROOT" ] || die "not a block device: $ROOT"

        ESP_TYPE=$(blkid -s TYPE -o value "$ESP" 2>/dev/null || true)
        case "$ESP_TYPE" in
            vfat|fat|fat32) ;;
            *) die "EFI partition must already be FAT32 (detected: ${ESP_TYPE:-unknown})" ;;
        esac

        yesno "Install the Obsidian UEFI bootloader into $ESP?" "n" || die "installation cancelled"
        if yesno "Format the root partition as ext4?" "n"; then
            mkfs.ext4 -F -L OBSIDIAN "$ROOT"
        fi
        ;;
    *) die "unknown installation mode" ;;
esac

ROOTFS=$(ask 'Path to rootfs.tar' '/rootfs.tar')
[ -f "$ROOTFS" ] || die "rootfs archive not found: $ROOTFS"
KERNEL=$(ask 'Path to kernel image' '/boot/vmlinuz')
[ -f "$KERNEL" ] || die "kernel image not found: $KERNEL"

HOSTNAME=$(ask 'Hostname' 'obsidian')
USERNAME=$(ask 'Username' 'user')
YSPM_REPO=$(ask 'yspm repository URL' 'https://github.com/Yassine-Jemi01/HardcoreLinux/releases/latest/download/repo-index.json')

case "$USERNAME" in
    ''|*[!a-zA-Z0-9._-]*) die "invalid username: $USERNAME" ;;
esac

TARGET=/mnt/obsidian
mkdir -p "$TARGET"
mount "$ROOT" "$TARGET"
trap 'umount "$TARGET/boot/efi" 2>/dev/null || true; umount "$TARGET" 2>/dev/null || true' EXIT INT TERM

mkdir -p "$TARGET/boot/efi"
mount "$ESP" "$TARGET/boot/efi"

printf '%s\n' 'Installing root filesystem...'
tar -xpf "$ROOTFS" -C "$TARGET"
rm -f "$TARGET/etc/hc-live"

mkdir -p "$TARGET/boot" "$TARGET/etc/yspm" "$TARGET/etc/profile.d" "$TARGET/home"
printf '%s\n' "$HOSTNAME" > "$TARGET/etc/hostname"

cat > "$TARGET/etc/yspm/env" <<EOF
export YSPM_REPOSITORY='$YSPM_REPO'
export YSPM_ROOT='/'
export YSPM_DATA_DIR='/var/lib/yspm'
export YSPM_CACHE_DIR='/var/cache/yspm'
EOF

cat > "$TARGET/etc/profile.d/yspm.sh" <<'EOF'
[ -f /etc/yspm/env ] && . /etc/yspm/env
EOF
chmod 0644 "$TARGET/etc/profile.d/yspm.sh"

chroot "$TARGET" /bin/sh -c "adduser -D -h /home/$USERNAME -s /bin/sh '$USERNAME' 2>/dev/null || adduser -h /home/$USERNAME -s /bin/sh '$USERNAME'"
chroot "$TARGET" /bin/sh -c "addgroup '$USERNAME' audio 2>/dev/null || true"
printf '%s\n' 'Set user password:'
chroot "$TARGET" passwd "$USERNAME"
printf '%s\n' 'Set root password:'
chroot "$TARGET" passwd root
chroot "$TARGET" /bin/sh -c "mkdir -p /home/$USERNAME/.config/obsidian-core; touch /home/$USERNAME/.config/obsidian-core/.first-login; chown -R $USERNAME:$USERNAME /home/$USERNAME"

ROOT_UUID=$(blkid -s UUID -o value "$ROOT")
ESP_UUID=$(blkid -s UUID -o value "$ESP")
[ -n "$ROOT_UUID" ] || die "could not read root filesystem UUID"
[ -n "$ESP_UUID" ] || die "could not read EFI filesystem UUID"

cat > "$TARGET/etc/fstab" <<EOF
UUID=$ROOT_UUID / ext4 defaults,noatime 0 1
UUID=$ESP_UUID /boot/efi vfat umask=0077 0 2
EOF

mkdir -p "$TARGET/boot/grub" "$TARGET/boot/efi/EFI/BOOT"
cp "$BOOTLOADER" "$TARGET/boot/efi/EFI/BOOT/BOOTX64.EFI"
cp "$KERNEL" "$TARGET/boot/vmlinuz"

cat > "$TARGET/boot/grub/grub.cfg" <<'EOF'
search --no-floppy --label --set=root OBSIDIAN
linux /boot/vmlinuz root=LABEL=OBSIDIAN rw init=/etc/init
boot
EOF

mkdir -p "$TARGET/etc/sudoers.d"
cat > "$TARGET/etc/sudoers.d/10-wheel" <<'EOF'
%wheel ALL=(ALL:ALL) ALL
EOF
chmod 0440 "$TARGET/etc/sudoers.d/10-wheel"

cat > "$TARGET/etc/motd" <<'EOF'
Obsidian Core Linux
GNOME desktop setup:
  sudo /usr/sbin/hc-setup-desktop

Package management:
  sudo yspm update
  sudo yspm install <package>
EOF

sync
printf '\n%s\n' 'Installation completed.'
printf '%s\n' "Root: $ROOT"
printf '%s\n' "User: $USERNAME"
printf '%s\n' "Hostname: $HOSTNAME"
printf '%s\n' 'Boot: embedded Obsidian Core Linux UEFI loader'
printf '%s\n' 'Reboot after the installer unmounts the target filesystem.'
