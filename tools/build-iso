#!/bin/sh
set -eu

[ "$(id -u)" = 0 ] || {
    echo "build-iso: run as root" >&2
    exit 1
}

[ "$#" -ge 3 ] || {
    echo "usage: build-iso <rootfs.tar> <kernel> <output.iso>" >&2
    exit 2
}

ROOTFS=$1
KERNEL=$2
OUTPUT=$3

for cmd in tar cpio gzip grub-mkrescue mktemp find; do
    command -v "$cmd" >/dev/null 2>&1 || {
        echo "build-iso: missing command: $cmd" >&2
        exit 1
    }
done

[ -f "$ROOTFS" ] || { echo "missing rootfs: $ROOTFS" >&2; exit 1; }
[ -f "$KERNEL" ] || { echo "missing kernel: $KERNEL" >&2; exit 1; }

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT INT TERM

mkdir -p "$WORK/live/boot" "$WORK/iso/boot/grub"
tar -xpf "$ROOTFS" -C "$WORK/live"
cp "$KERNEL" "$WORK/live/boot/vmlinuz"
cp "$ROOTFS" "$WORK/live/rootfs.tar"

cat > "$WORK/live/init" <<'EOF'
#!/bin/sh
set -eu

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sys /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mkdir -p /dev/pts /dev/mqueue /run /tmp
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t mqueue mqueue /dev/mqueue 2>/dev/null || true

exec /etc/init
EOF
chmod 0755 "$WORK/live/init"

(
    cd "$WORK/live"
    find . -print | cpio -o -H newc 2>/dev/null | gzip -9 > "$WORK/iso/boot/initramfs.img"
)

cp "$KERNEL" "$WORK/iso/boot/vmlinuz"

cat > "$WORK/iso/boot/grub/grub.cfg" <<'EOF'
set timeout=4
set default=0

menuentry 'Obsidian Core Linux' {
    linux /boot/vmlinuz rdinit=/init
    initrd /boot/initramfs.img
}

menuentry 'Obsidian Core Linux (installer)' {
    linux /boot/vmlinuz rdinit=/init
    initrd /boot/initramfs.img
}
EOF

grub-mkrescue -o "$OUTPUT" "$WORK/iso"
echo "$OUTPUT"
