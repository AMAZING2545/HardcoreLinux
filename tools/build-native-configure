#!/bin/sh
set -eu

[ "$#" -ge 4 ] || {
    echo "usage: build-native-configure <source-dir> <output.yspkg> <name> <version> [description]" >&2
    exit 2
}

DIR=$1
OUT=$2
NAME=$3
VERSION=$4
DESCRIPTION="${5:-Native Obsidian Core Linux package}"
PREFIX="${PREFIX:-/usr}"
ABI="${YSPM_ABI:-yspm-abi-1}"
ARCH="${ARCH:-x86_64}"
YSPM_BIN="${YSPM_BIN:-yspm}"

command -v "$YSPM_BIN" >/dev/null 2>&1 || { echo "yspm is required" >&2; exit 1; }

STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT INT TERM

cd "$DIR"
if [ -x ./autogen.sh ] && [ ! -f ./configure ]; then
    ./autogen.sh
fi
if [ -x ./configure ]; then
    ./configure --prefix="$PREFIX" --sysconfdir=/etc --localstatedir=/var
else
    echo "configure script not found" >&2
    exit 1
fi
make -j"$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)"
make DESTDIR="$STAGE" install

"$YSPM_BIN" build   --root "$STAGE"   --output "$OUT"   --name "$NAME"   --version "$VERSION"   --description "$DESCRIPTION"   --abi "$ABI"   --arch "$ARCH"   --license "${LICENSE:-GPL-2.0-or-later}"

echo "$OUT"
