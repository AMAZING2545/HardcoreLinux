#!/bin/sh
set -eu

[ "$#" -ge 2 ] || {
    echo "usage: extract-kernel <archive.tar> <output>" >&2
    exit 2
}

ARCHIVE=$1
OUTPUT=$2
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT INT TERM

for cmd in tar find file head cp chmod; do
    command -v "$cmd" >/dev/null 2>&1 || {
        echo "extract-kernel: missing command: $cmd" >&2
        exit 1
    }
done

[ -f "$ARCHIVE" ] || {
    echo "extract-kernel: archive not found: $ARCHIVE" >&2
    exit 1
}

tar -xf "$ARCHIVE" -C "$TMP"

KERNEL=
for pattern in 'vmlinuz' 'vmlinuz-*' 'bzImage' 'Image' 'zImage'; do
    KERNEL=$(find "$TMP" -type f -name "$pattern" -print -quit)
    [ -n "$KERNEL" ] && break
done

if [ -z "$KERNEL" ]; then
    while IFS= read -r candidate; do
        kind=$(file -b "$candidate" 2>/dev/null || true)
        case "$kind" in
            *"Linux kernel x86 boot executable"*|*"Linux kernel ARM64 boot executable"*|*"Linux kernel"*bzImage*)
                KERNEL=$candidate
                break
                ;;
        esac
    done <<EOF
$(find "$TMP" -type f -size +1M -print)
EOF
fi

[ -n "$KERNEL" ] || {
    echo "extract-kernel: no Linux kernel image found in $ARCHIVE" >&2
    echo "extract-kernel: archive contents:" >&2
    find "$TMP" -type f -printf '%P\n' | head -n 80 >&2
    exit 1
}

KERNEL_TYPE=$(file -b "$KERNEL" 2>/dev/null || true)
case "$KERNEL_TYPE" in
    "Linux kernel x86 boot executable"*|    "Linux kernel ARM64 boot executable"*|    *"Linux kernel x86 boot executable bzImage"*)
        ;;
    *)
        echo "extract-kernel: selected file is not a supported Linux kernel: $KERNEL" >&2
        echo "extract-kernel: file type: $KERNEL_TYPE" >&2
        exit 1
        ;;
esac

cp "$KERNEL" "$OUTPUT"
chmod 0644 "$OUTPUT"
printf 'kernel: %s\n' "$KERNEL"
printf 'type: %s\n' "$KERNEL_TYPE"
printf '%s\n' "$OUTPUT"
