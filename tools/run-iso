#!/bin/sh
set -eu

ISO="${1:-ObsidianCoreLinux.iso}"
RAM="${RAM:-2048}"
CPUS="${CPUS:-2}"

command -v qemu-system-x86_64 >/dev/null 2>&1 || {
    echo "run-iso: qemu-system-x86_64 is required" >&2
    exit 1
}

[ -f "$ISO" ] || {
    echo "run-iso: ISO not found: $ISO" >&2
    exit 1
}

OVMF_CODE=
for candidate in \
    /usr/share/OVMF/OVMF_CODE.fd \
    /usr/share/OVMF/OVMF_CODE_4M.fd \
    /usr/share/edk2/x64/OVMF_CODE.fd \
    /usr/share/edk2-ovmf/x64/OVMF_CODE.fd; do
    if [ -f "$candidate" ]; then
        OVMF_CODE="$candidate"
        break
    fi
done

[ -n "$OVMF_CODE" ] || {
    echo "run-iso: OVMF firmware is required for UEFI boot" >&2
    exit 1
}

QEMU_ARGS="
-machine
q35
-smp
$CPUS
-m
$RAM
-drive
if=pflash,format=raw,readonly=on,file=$OVMF_CODE
-cdrom
$ISO
-boot
d
-serial
mon:stdio
"

if [ -r /dev/kvm ] && [ -w /dev/kvm ]; then
    echo "run-iso: KVM acceleration enabled"
    exec qemu-system-x86_64 -enable-kvm -cpu host $QEMU_ARGS
fi

echo "run-iso: /dev/kvm unavailable; using software emulation (TCG)"
exec qemu-system-x86_64 -accel tcg,thread=multi -cpu max $QEMU_ARGS
