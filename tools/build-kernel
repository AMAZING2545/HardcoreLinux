#!/bin/sh
set -eu

KERNEL_VERSION="${KERNEL_VERSION:-7.2.6}"
KERNEL_URL="${KERNEL_URL:-https://www.kernel.org/pub/linux/kernel/v7.x/linux-${KERNEL_VERSION}.tar.xz}"
KERNEL_SHA256="${KERNEL_SHA256:-039aef84f2b0994aeda3f4fcfc3d02ec9d7a9bbb9020ea264c43f446c860f606}"
CONFIG_FILE="${KERNEL_CONFIG:-$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)/configs/linux.config.7.2}"
OUTPUT="${1:-/tmp/vmlinuz}"
MODULES_OUTPUT="${2:-/tmp/kernel-modules}"
WORKDIR="${KERNEL_WORKDIR:-/tmp/obsidian-kernel}"

die() {
    echo "build-kernel: $*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

for cmd in curl sha256sum tar make sed grep install getconf; do
    need "$cmd"
done

[ -f "$CONFIG_FILE" ] || die "kernel config not found: $CONFIG_FILE"

mkdir -p "$WORKDIR"
ARCHIVE="$WORKDIR/linux-$KERNEL_VERSION.tar.xz"
SOURCE="$WORKDIR/linux-$KERNEL_VERSION"

if [ ! -f "$ARCHIVE" ]; then
    echo "downloading Linux $KERNEL_VERSION source"
    curl -fL --retry 3 --retry-delay 2 -o "$ARCHIVE" "$KERNEL_URL"
fi

echo "$KERNEL_SHA256  $ARCHIVE" | sha256sum -c -

if [ ! -d "$SOURCE" ]; then
    tar -xJf "$ARCHIVE" -C "$WORKDIR"
fi

[ -d "$SOURCE" ] || die "kernel source tree was not extracted"

rm -rf "$MODULES_OUTPUT"
mkdir -p "$MODULES_OUTPUT"

cp "$CONFIG_FILE" "$SOURCE/.config"

set_config() {
    key="$1"
    value="$2"
    if grep -q "^# $key is not set$" "$SOURCE/.config"; then
        sed -i "s|^# $key is not set$|$key=$value|" "$SOURCE/.config"
    elif grep -q "^$key=" "$SOURCE/.config"; then
        sed -i "s|^$key=.*|$key=$value|" "$SOURCE/.config"
    else
        printf '%s=%s\n' "$key" "$value" >> "$SOURCE/.config"
    fi
}

unset_config() {
    key="$1"
    if grep -q "^$key=" "$SOURCE/.config"; then
        sed -i "s|^$key=.*|# $key is not set|" "$SOURCE/.config"
    fi
}

set_string_config() {
    key="$1"
    value="$2"
    if grep -q "^$key=" "$SOURCE/.config"; then
        sed -i "s|^$key=.*|$key=\"$value\"|" "$SOURCE/.config"
    elif grep -q "^# $key is not set$" "$SOURCE/.config"; then
        sed -i "s|^# $key is not set$|$key=\"$value\"|" "$SOURCE/.config"
    else
        printf '%s="%s"\n' "$key" "$value" >> "$SOURCE/.config"
    fi
}

# The live ISO uses an external gzip-compressed initramfs.
set_config CONFIG_BLK_DEV_INITRD y
set_config CONFIG_RD_GZIP y
set_config CONFIG_RD_BZIP2 y
set_config CONFIG_RD_LZMA y
set_config CONFIG_RD_XZ y
set_config CONFIG_RD_LZO y
set_config CONFIG_RD_LZ4 y
set_config CONFIG_RD_ZSTD y

# Never bake a machine-specific root device into the distribution kernel.
set_config CONFIG_CMDLINE_BOOL y
set_string_config CONFIG_CMDLINE ""
unset_config CONFIG_CMDLINE_OVERRIDE

# Required for the QEMU installer/installed-system test and common VM storage.
set_config CONFIG_VIRTIO y
set_config CONFIG_VIRTIO_PCI y
set_config CONFIG_VIRTIO_BLK y

# Keep common real-hardware storage and USB support built in.
set_config CONFIG_ATA y
set_config CONFIG_SATA_AHCI y
set_config CONFIG_EFI y
set_config CONFIG_EFI_STUB y
set_config CONFIG_EFI_PARTITION y
set_config CONFIG_DEVTMPFS y
set_config CONFIG_DEVTMPFS_MOUNT y
set_config CONFIG_EXT4_FS y
set_config CONFIG_ISO9660_FS y
set_config CONFIG_VFAT_FS y
set_config CONFIG_MSDOS_FS y
set_config CONFIG_USB_STORAGE y
set_config CONFIG_HID_GENERIC y
set_config CONFIG_SERIAL_8250_CONSOLE y

(
    cd "$SOURCE"
    make olddefconfig
    make -j"$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)" bzImage modules
    make modules_install INSTALL_MOD_PATH="$MODULES_OUTPUT"
)

[ -s "$SOURCE/arch/x86/boot/bzImage" ] || die "kernel build did not produce bzImage"
[ -d "$MODULES_OUTPUT/lib/modules" ] || die "kernel modules were not installed"

mkdir -p "$(dirname "$OUTPUT")"
install -m 0644 "$SOURCE/arch/x86/boot/bzImage" "$OUTPUT"

echo "kernel: $OUTPUT"
echo "modules: $MODULES_OUTPUT/lib/modules"
