#!/bin/sh
set -eu

die() { printf 'hc-setup-desktop: %s\n' "$*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "run as root"
command -v yspm >/dev/null 2>&1 || die "yspm is not installed"
command -v initctl >/dev/null 2>&1 || true

printf '\033c'
printf '%s\n' 'Hardcore Linux desktop setup'
printf '%s\n\n' 'yspm is the only package manager used by this setup script.'

printf '%s\n' 'Choose a window manager:'
printf '  1) sway\n'
printf '  2) labwc\n'
printf 'Selection [1]: '
read -r choice || true
[ -n "${choice:-}" ] || choice=1

case "$choice" in
    1) WM=sway; WM_PACKAGES="sway foot wofi waybar" ;;
    2) WM=labwc; WM_PACKAGES="labwc foot wofi waybar" ;;
    *) die "invalid selection" ;;
esac

printf 'Install TUI display manager ly? [Y/n]: '
read -r answer || true
case "${answer:-y}" in
    n|N) USE_LY=0 ;;
    *) USE_LY=1 ;;
esac

printf 'Install PipeWire audio stack? [Y/n]: '
read -r answer || true
case "${answer:-y}" in
    n|N) USE_AUDIO=0 ;;
    *) USE_AUDIO=1 ;;
esac

printf 'Install iwd wireless networking? [Y/n]: '
read -r answer || true
case "${answer:-y}" in
    n|N) USE_IWD=0 ;;
    *) USE_IWD=1 ;;
esac

yspm update

install_package() {
    package="$1"
    printf 'Installing %s...\n' "$package"
    if yspm install "$package" --yes; then
        printf '%s\n' "  [ ok ] $package"
    else
        printf '%s\n' "  [ warn ] package unavailable: $package"
    fi
}

install_package udev
install_package dbus
for package in $WM_PACKAGES; do
    install_package "$package"
done
[ "$USE_LY" = 1 ] && install_package ly
if [ "$USE_AUDIO" = 1 ]; then
    install_package pipewire
    install_package wireplumber
fi
[ "$USE_IWD" = 1 ] && install_package iwd

mkdir -p /etc/profile.d /etc/sway /etc/labwc /etc/iwd /system/services /system/tmp
: > /system/tmp/services

cat > /etc/profile.d/20-desktop.sh <<'EOF'
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

if command -v pipewire >/dev/null 2>&1 && ! pidof pipewire >/dev/null 2>&1; then
    pipewire >/tmp/pipewire.log 2>&1 &
fi
if command -v wireplumber >/dev/null 2>&1 && ! pidof wireplumber >/dev/null 2>&1; then
    wireplumber >/tmp/wireplumber.log 2>&1 &
fi
if command -v pipewire-pulse >/dev/null 2>&1 && ! pidof pipewire-pulse >/dev/null 2>&1; then
    pipewire-pulse >/tmp/pipewire-pulse.log 2>&1 &
fi
EOF
chmod 0644 /etc/profile.d/20-desktop.sh

cat > /system/services/iwd <<'EOF'
#!/bin/sh
exec iwd -d
EOF
chmod 0755 /system/services/iwd

cat > /etc/sway/config <<'EOF'
set $mod Mod4
font pango:monospace 10
exec_always sh -c 'command -v waybar >/dev/null && waybar'
bindsym $mod+Return exec foot
bindsym $mod+d exec wofi --show drun
bindsym $mod+Shift+e exec swaymsg exit
EOF

cat > /etc/labwc/rc.xml <<'EOF'
<?xml version="1.0" ?>
<labwc_config>
  <core>
    <decoration>client</decoration>
  </core>
</labwc_config>
EOF

cat > /etc/default/hardcore-desktop <<EOF
WM=$WM
LY=$USE_LY
PIPEWIRE=$USE_AUDIO
IWD=$USE_IWD
EOF

if [ "$USE_IWD" = 1 ] && command -v initctl >/dev/null 2>&1; then
    initctl enable iwd || true
fi

printf '\n%s\n' 'Desktop setup finished.'
printf '%s\n' "Selected WM: $WM"
printf '%s\n' 'Re-login or reboot to let the desktop/session configuration take effect.'
